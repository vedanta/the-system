%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#059669'}}}%%
flowchart TB
    %% Key Interaction Patterns

    subgraph CENTRAL["🎩 CENTRAL COORDINATION"]
        FA[("Founder-Advisor<br/>🎭 All Communication Hub")]
    end

    subgraph PATTERNS["🔄 KEY INTERACTION PATTERNS"]

        subgraph P1["📐 Architecture Assessment"]
            SA1[("🎯 Solution Architect")] -->|"Tech Assessment"| EA1[("🏗️ Enterprise Architect")]
        end

        subgraph P2["📦 Product Collaboration"]
            PL1[("👔 Product Lead")] <-->|"Scope & Timeline"| PP1[("📅 Project Planner")]
            PL1 <-->|"Market Insights"| BA1[("💼 Business Analyst")]
        end

        subgraph P3["💻 QA Review Cycle"]
            QA1[("🧪 QA Engineer")]
            QA1 -->|"Reviews All Work"| DB1[("🗄️ Database Dev")]
            QA1 -->|"Reviews All Work"| BE1[("⚙️ Backend Dev")]
            QA1 -->|"Reviews All Work"| FE1[("🎨 Frontend Dev")]
            QA1 -->|"E2E Testing"| IE1[("🔗 Integration")]
        end

        subgraph P4["🚀 Release Pipeline"]
            TW1[("📝 Technical Writer")] -->|"Documentation"| SE1[("🔐 Security")]
            SE1 -->|"Security Clearance"| RE1[("📦 Release")]
            RE1 -->|"Release Package"| DO1[("🚀 DevOps")]
        end

        subgraph P5["🌐 Operations Coordination"]
            SRD1[("🚀 SRE Deploy")] <-->|"Platform Status"| SRO1[("🛡️ SRE Ops")]
        end

        subgraph P6["🐛 Emergency Support"]
            BF1[("🐛 Bug Fixer")]
            DB2[("Any Agent")] -.->|"Issues"| BF1
            BF1 -.->|"Fixes"| QA2[("QA Review")]
        end
    end

    %% Central Coordination
    FA -.->|"Coordinates"| SA1
    FA -.->|"Coordinates"| PL1
    FA -.->|"Coordinates"| QA1
    FA -.->|"Coordinates"| TW1
    FA -.->|"Coordinates"| SRD1
    FA -.->|"Can Call"| BF1

    %% Stage Handoffs
    EA1 -.->|"Architecture"| PL1
    BA1 -.->|"Requirements"| DB1
    IE1 -.->|"Code Complete"| TW1
    DO1 -.->|"Infrastructure"| SRD1

    %% Cross-Stage Coordination
    SE1 -.->|"Security Reqs"| QA1
    SRO1 -.->|"Ops Insights"| EA1

    %% Styling
    classDef central fill:#059669,stroke:#333,stroke-width:3px,color:#fff
    classDef pattern fill:#ecfdf5,stroke:#059669,stroke-width:2px
    classDef agent fill:#d1fae5,stroke:#059669
    classDef handoff stroke:#f59e0b,stroke-width:2px,stroke-dasharray: 5 5

    class FA central
    class SA1,EA1,PL1,PP1,BA1,QA1,DB1,BE1,FE1,IE1,TW1,SE1,RE1,DO1,SRD1,SRO1,BF1,DB2,QA2 agent