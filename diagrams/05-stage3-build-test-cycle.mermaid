%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#dda0dd'}}}%%
flowchart TD
    DEV["/ts-develop<br/>👨‍💼 Principal"] --> QA["/ts-test-plan<br/>🧪 QA"]
    
    QA --> DB_BUILD["/ts-build database<br/>🗄️ DB Dev"]
    DB_BUILD --> DB_TEST{"/ts-test database<br/>🧪 QA"}
    DB_TEST -->|"❌ fail"| DB_BUILD
    DB_TEST -->|"✅ pass"| BE_BUILD
    
    BE_BUILD["/ts-build backend<br/>⚙️ BE Dev"] --> BE_TEST{"/ts-test backend<br/>🧪 QA"}
    BE_TEST -->|"❌ fail"| BE_BUILD
    BE_TEST -->|"✅ pass"| FE_BUILD
    
    FE_BUILD["/ts-build frontend<br/>🎨 FE Dev"] --> FE_TEST{"/ts-test frontend<br/>🧪 QA"}
    FE_TEST -->|"❌ fail"| FE_BUILD
    FE_TEST -->|"✅ pass"| INT
    
    INT["/ts-integrate<br/>🔗 Integration"] --> INT_TEST{"/ts-test integration<br/>🧪 E2E"}
    INT_TEST -->|"❌ fail"| INT
    INT_TEST -->|"✅ pass"| GATE
    
    GATE["/ts-gate<br/>👨‍💼 Principal"] --> SIGNOFF["/ts-signoff<br/>🧪 QA"]
    SIGNOFF --> DONE["✅ Development Complete"]

    %% Styling
    classDef build fill:#4ecdc4,stroke:#333
    classDef test fill:#f7dc6f,stroke:#333
    classDef lead fill:#bb8fce,stroke:#333
    classDef success fill:#2ecc71,stroke:#333,stroke-width:2px,color:#fff
    
    class DEV,GATE lead
    class QA,SIGNOFF test
    class DB_BUILD,BE_BUILD,FE_BUILD,INT build
    class DB_TEST,BE_TEST,FE_TEST,INT_TEST test
    class DONE success
