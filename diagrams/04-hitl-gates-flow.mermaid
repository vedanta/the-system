%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#ff6b6b'}}}%%
flowchart TD
    G1{{"🚪 architecture-start"}} --> G2{{"🚪 architecture-lock"}}
    G2 --> G3{{"🚪 green-light 🚦"}}
    G3 --> G4{{"🚪 development"}}
    G4 --> G5{{"🚪 release"}}
    G5 --> G6{{"🚪 staging"}}
    G6 --> G7{{"🚪 production"}}
    G7 --> G8{{"🚪 launch 🚀"}}
    G8 --> SUCCESS["🎉 LAUNCHED"]
    
    G1 -.->|"Stage 1"| G2
    G2 -.->|"Stage 2"| G3
    G3 -.->|"Stage 3"| G4
    G4 -.->|"Stage 4"| G5
    G5 -.->|"Deploy"| G6
    G6 -.->|"Verify"| G7
    G7 -.->|"Final"| G8

    %% Styling
    classDef gate fill:#ff6b6b,stroke:#333,stroke-width:2px,color:#fff
    classDef success fill:#2ecc71,stroke:#333,stroke-width:3px,color:#fff
    
    class G1,G2,G3,G4,G5,G6,G7,G8 gate
    class SUCCESS success
