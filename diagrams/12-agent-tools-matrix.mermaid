    %% Styling
    classDef tools fill:#dc2626,stroke:#333,stroke-width:2px,color:#fff
    classDef fullAccess fill:#059669,stroke:#333,stroke-width:2px,color:#fff
    classDef coreAccess fill:#0ea5e9,stroke:#333,stroke-width:2px
    classDef docAccess fill:#8b5cf6,stroke:#333,stroke-width:2px
    classDef researchAccess fill:#f59e0b,stroke:#333,stroke-width:2px
    classDef capability fill:#f3f4f6,stroke:#6b7280,stroke-width:1px

    class READ,WRITE,EDIT,BASH,GREP,WEB,TODO,TASK tools
    class F1 fullAccess
    class C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12,C13,C14 coreAccess
    class D1,D2 docAccess
    class R1,R2 researchAccess
    class AI1,T1,T2,T3,B1,B2,B3,B4,O1,O2,O3,S1,S2,S3,S4 capability