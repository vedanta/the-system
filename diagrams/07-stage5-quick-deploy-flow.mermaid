%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#ffa07a'}}}%%
flowchart TD
    subgraph ENTRY["📥 Entry Point"]
        START["After Stage 3<br/>/ts-approve development"] 
    end

    subgraph DEPLOY["🚀 SRE Deploy Engineer"]
        START --> DB["/ts-push neon<br/>🗄️ Database"]
        DB --> DB_URL["postgresql://..."]
        DB_URL --> BE["/ts-push railway<br/>⚙️ Backend"]
        BE --> BE_URL["https://api.railway.app"]
        BE_URL --> FE["/ts-push vercel<br/>🎨 Frontend"]
        FE --> FE_URL["https://app.vercel.app"]
        
        FE_URL --> STATUS["/ts-live-status<br/>Check All"]
        STATUS --> DOMAIN["/ts-domain vercel<br/>myapp.com"]
    end

    subgraph OPS["🛡️ SRE Ops Engineer"]
        DOMAIN --> MONITOR["/ts-monitor<br/>Sentry + Datadog"]
        MONITOR --> ALERTS["/ts-alerts<br/>Slack + PagerDuty"]
        ALERTS --> SLO["/ts-slo<br/>99.9% Availability"]
        SLO --> STATUS_PAGE["/ts-status-page<br/>status.myapp.com"]
    end

    subgraph ONGOING["🔄 Ongoing Operations"]
        STATUS_PAGE --> HEALTH["/ts-health<br/>Health Checks"]
        HEALTH --> LOGS["/ts-logs<br/>View Logs"]
        LOGS --> INCIDENT["/ts-incident<br/>Handle Issues"]
        INCIDENT --> HEALTH
    end

    STATUS_PAGE --> LIVE["🌐 OPERATIONAL!"]

    %% Styling
    classDef deploy fill:#4ecdc4,stroke:#333
    classDef ops fill:#bb8fce,stroke:#333
    classDef url fill:#f7dc6f,stroke:#333
    classDef success fill:#2ecc71,stroke:#333,stroke-width:3px,color:#fff
    classDef ongoing fill:#87ceeb,stroke:#333
    
    class DB,BE,FE,STATUS,DOMAIN deploy
    class MONITOR,ALERTS,SLO,STATUS_PAGE ops
    class DB_URL,BE_URL,FE_URL url
    class LIVE success
    class HEALTH,LOGS,INCIDENT ongoing
