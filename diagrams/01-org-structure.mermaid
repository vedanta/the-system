%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#4ecdc4'}}}%%
flowchart TB
    subgraph FOUNDER["👤 HUMAN FOUNDER (You)"]
        F[("Founder<br/>HITL Gates")]
    end
    
    subgraph EXECUTIVE["🎩 EXECUTIVE"]
        FA[("🎩 Founder-Advisor<br/>Chief of Staff")]
    end
    
    subgraph STAGE1["📐 STAGE 1: ARCHITECTURE"]
        SA[("🎯 Solution Architect<br/>Technology Assessment")]
        EA[("🏗️ Enterprise Architect<br/>System Design, ADRs")]
    end
    
    subgraph STAGE2["📦 STAGE 2: PRODUCT"]
        PL[("👔 Product Lead<br/>MVP, User Stories, PRD")]
        PP[("📅 Project Planner<br/>Roadmap, Sprints")]
        BA[("💼 Business Analyst<br/>Market Analysis, GTM")]
    end
    
    subgraph STAGE3["💻 STAGE 3: DEVELOPMENT"]
        PD[("👨‍💼 Principal Developer<br/>Tech Lead, Code Review")]
        QA[("🧪 QA Engineer<br/>Test Strategy, Sign-off")]
        
        subgraph DEV_TEAM["Development Team"]
            DB[("🗄️ Database Developer<br/>Schema, Migrations")]
            BE[("⚙️ Backend Developer<br/>APIs, Services")]
            FE[("🎨 Frontend Developer<br/>Components, UI")]
            IE[("🔗 Integration Engineer<br/>E2E, Docker")]
        end
    end
    
    subgraph STAGE4["🚀 STAGE 4: RELEASE"]
        TW[("📝 Technical Writer<br/>Docs, Guides, README")]
        SE[("🔐 Security Engineer<br/>Scans, Compliance")]
        RE[("📦 Release Engineer<br/>Version, Changelog")]
        DO[("🚀 DevOps Engineer<br/>IaC, CI/CD, Deploy")]
    end
    
    subgraph STAGE5["🌐 STAGE 5: GO LIVE (Optional)"]
        SRD[("🚀 SRE Deploy<br/>Platform Deployment")]
        SRO[("🛡️ SRE Ops<br/>Monitoring, Incidents")]
    end
    
    %% Relationships
    F --> FA
    FA --> SA
    FA --> PL
    FA --> PD
    FA --> TW
    FA --> SRD

    SA --> EA
    EA -.->|architecture| PL
    PL --> PP
    PL --> BA
    PP -.->|green light| PD
    
    PD --> QA
    PD --> DB
    PD --> BE
    PD --> FE
    PD --> IE
    QA -.->|reviews| DB
    QA -.->|reviews| BE
    QA -.->|reviews| FE
    QA -.->|reviews| IE
    
    PD -.->|handoff| TW
    TW --> SE
    SE --> RE
    RE --> DO
    
    DO -.->|or| SRD
    SRD --> SRO
    
    %% Styling
    classDef founder fill:#f9f,stroke:#333,stroke-width:2px
    classDef executive fill:#ffd700,stroke:#333,stroke-width:2px
    classDef stage1 fill:#87ceeb,stroke:#333
    classDef stage2 fill:#98fb98,stroke:#333
    classDef stage3 fill:#dda0dd,stroke:#333
    classDef stage4 fill:#f0e68c,stroke:#333
    classDef stage5 fill:#ffa07a,stroke:#333
    
    class F founder
    class FA executive
    class SA,EA stage1
    class PL,PP,BA stage2
    class PD,QA,DB,BE,FE,IE stage3
    class TW,SE,RE,DO stage4
    class SRD,SRO stage5
