%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#f0e68c'}}}%%
flowchart TD
    subgraph PREP["📝 Preparation"]
        DOCS["/ts-docs<br/>📝 Technical Writer"] --> SEC["/ts-security<br/>🔐 Security Engineer"]
        SEC --> SEC_CHECK{"Security<br/>Status?"}
        SEC_CHECK -->|"❌ FAIL"| FIX["Fix Issues"] --> SEC
        SEC_CHECK -->|"✅ PASS"| REL
        SEC_CHECK -->|"⚠️ CONDITIONAL"| REL
        REL["/ts-release<br/>📦 Release Engineer"] --> INFRA["/ts-infra<br/>🚀 DevOps"]
        INFRA --> PIPE["/ts-pipeline<br/>🚀 DevOps"]
    end

    subgraph REVIEW["👀 Review"]
        PIPE --> REV["/ts-review release<br/>🎩 Founder-Advisor"]
        REV --> GATE1{{"👤 /ts-approve<br/>release"}}
    end

    subgraph STAGING["🧪 Staging"]
        GATE1 -->|approved| DEP_STG["/ts-deploy staging<br/>🚀 DevOps"]
        DEP_STG --> VER_STG["/ts-verify staging<br/>🚀 DevOps"]
        VER_STG --> GATE2{{"👤 /ts-approve<br/>staging"}}
    end

    subgraph PRODUCTION["🚀 Production"]
        GATE2 -->|approved| SEC_PROD["/ts-security production<br/>🔐 Security"]
        SEC_PROD --> SEC_PROD_CHECK{"Security<br/>Status?"}
        SEC_PROD_CHECK -->|"🔴 CRITICAL"| BLOCK["❌ BLOCKED"]
        SEC_PROD_CHECK -->|"✅ PASS"| DEP_PROD
        DEP_PROD["/ts-deploy production<br/>🚀 DevOps"] --> VER_PROD["/ts-verify production<br/>🚀 DevOps"]
        VER_PROD --> GATE3{{"👤 /ts-approve<br/>production"}}
        GATE3 -->|approved| GATE4{{"👤 /ts-approve<br/>launch 🚀"}}
    end

    GATE4 --> LIVE["🎉 LIVE!"]

    %% Styling
    classDef gate fill:#ff6b6b,stroke:#333,stroke-width:2px,color:#fff
    classDef command fill:#4ecdc4,stroke:#333
    classDef security fill:#ffa07a,stroke:#333
    classDef success fill:#2ecc71,stroke:#333,stroke-width:3px,color:#fff
    classDef blocked fill:#ff0000,stroke:#333,color:#fff
    
    class GATE1,GATE2,GATE3,GATE4 gate
    class DOCS,REL,INFRA,PIPE,DEP_STG,VER_STG,DEP_PROD,VER_PROD command
    class SEC,SEC_PROD security
    class LIVE success
    class BLOCK blocked
