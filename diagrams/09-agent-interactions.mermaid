%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#6366f1'}}}%%
flowchart TD
    %% Central coordination hub
    FA[("🎩 Founder-Advisor<br/>Central Coordination<br/>All agent communication")]

    %% Stage 1: Architecture
    subgraph ARCH["📐 ARCHITECTURE AGENTS"]
        SA[("🎯 Solution Architect<br/>Technology Assessment")]
        EA[("🏗️ Enterprise Architect<br/>System Design")]
    end

    %% Stage 2: Product
    subgraph PROD["📦 PRODUCT AGENTS"]
        PL[("👔 Product Lead<br/>MVP Definition")]
        PP[("📅 Project Planner<br/>Roadmap & Sprints")]
        BA[("💼 Business Analyst<br/>Market Analysis")]
    end

    %% Stage 3: Development
    subgraph DEV["💻 DEVELOPMENT AGENTS"]
        PD[("👨‍💼 Principal Developer<br/>Tech Leadership")]
        QA[("🧪 QA Engineer<br/>Quality Assurance")]

        subgraph BUILDERS["Build Specialists"]
            DB[("🗄️ Database Developer")]
            BE[("⚙️ Backend Developer")]
            FE[("🎨 Frontend Developer")]
            IE[("🔗 Integration Engineer")]
        end
    end

    %% Stage 4: Release
    subgraph REL["🚀 RELEASE AGENTS"]
        TW[("📝 Technical Writer<br/>Documentation")]
        SE[("🔐 Security Engineer<br/>Security Validation")]
        RE[("📦 Release Engineer<br/>Version Management")]
        DO[("🚀 DevOps Engineer<br/>Infrastructure")]
    end

    %% Stage 5: Operations
    subgraph OPS["🌐 OPERATIONS AGENTS"]
        SRD[("🚀 SRE Deploy<br/>Platform Deployment")]
        SRO[("🛡️ SRE Ops<br/>Monitoring & SLOs")]
    end

    %% Utility
    BF[("🐛 Bug Fixer<br/>Error Resolution<br/>(Called by any agent)")]

    %% CENTRAL HUB CONNECTIONS
    FA -.->|"coordinates all"| SA
    FA -.->|"coordinates all"| PL
    FA -.->|"coordinates all"| PD
    FA -.->|"coordinates all"| TW
    FA -.->|"coordinates all"| SRD

    %% STAGE 1: ARCHITECTURE INTERACTIONS
    SA -->|"tech assessment<br/>handoff"| EA
    EA -.->|"architecture<br/>guidance"| PL

    %% STAGE 2: PRODUCT INTERACTIONS
    PL -->|"MVP scope"| PP
    PL -->|"product requirements"| BA
    PP -.->|"timeline feedback"| PL
    BA -.->|"market insights"| PL
    PP <-->|"sprint coordination"| BA

    %% STAGE 2 → 3 HANDOFF
    PL -->|"PRD & requirements"| PD
    PP -->|"sprint plan"| PD
    BA -->|"business context"| PD

    %% STAGE 3: DEVELOPMENT INTERACTIONS
    PD -->|"implementation plan"| DB
    PD -->|"implementation plan"| BE
    PD -->|"implementation plan"| FE
    PD -->|"integration strategy"| IE
    PD <-->|"technical guidance"| QA

    %% QA REVIEW RELATIONSHIPS (Critical!)
    QA -->|"reviews & tests"| DB
    QA -->|"reviews & tests"| BE
    QA -->|"reviews & tests"| FE
    QA -->|"E2E validation"| IE
    QA -.->|"quality feedback"| PD

    %% DEVELOPMENT TEAM COORDINATION
    DB -->|"schema & APIs"| BE
    BE -->|"API contracts"| FE
    FE -.->|"requirements clarification"| BE
    IE -->|"integration needs"| DB
    IE -->|"integration needs"| BE
    IE -->|"integration needs"| FE

    %% STAGE 3 → 4 HANDOFF
    PD -->|"code complete<br/>architecture docs"| TW
    QA -->|"test results<br/>quality sign-off"| SE

    %% STAGE 4: RELEASE INTERACTIONS
    TW -->|"documentation"| SE
    SE -->|"security clearance"| RE
    RE -->|"release package"| DO
    TW -.->|"deployment docs"| DO
    SE -.->|"security configs"| DO

    %% STAGE 4 → 5 HANDOFF (Alternative path)
    PD -.->|"quick deploy<br/>(skip Stage 4)"| SRD
    DO -->|"full IaC deploy"| SRD

    %% STAGE 5: OPERATIONS INTERACTIONS
    SRD -->|"deployment status"| SRO
    SRO -.->|"ops feedback"| SRD
    SRD <-->|"platform coordination"| SRO

    %% UTILITY INTERACTIONS
    DB -.->|"database issues"| BF
    BE -.->|"backend issues"| BF
    FE -.->|"frontend issues"| BF
    IE -.->|"integration issues"| BF
    DO -.->|"deployment issues"| BF
    BF -.->|"fixed code"| QA

    %% CROSS-STAGE COORDINATION
    EA -.->|"architecture updates"| PD
    PD -.->|"technical feasibility"| PP
    SE -.->|"security requirements"| PD
    SRO -.->|"operational insights"| EA

    %% REVIEW CYCLES (dotted for clarity)
    TW -.->|"doc review requests"| PD
    SE -.->|"security review requests"| PD
    RE -.->|"release readiness"| QA

    %% Styling
    classDef central fill:#6366f1,stroke:#333,stroke-width:3px,color:#fff
    classDef arch fill:#87ceeb,stroke:#333,stroke-width:2px
    classDef product fill:#98fb98,stroke:#333,stroke-width:2px
    classDef dev fill:#dda0dd,stroke:#333,stroke-width:2px
    classDef release fill:#f0e68c,stroke:#333,stroke-width:2px
    classDef ops fill:#ffa07a,stroke:#333,stroke-width:2px
    classDef utility fill:#ffb6c1,stroke:#333,stroke-width:2px

    class FA central
    class SA,EA arch
    class PL,PP,BA product
    class PD,QA,DB,BE,FE,IE dev
    class TW,SE,RE,DO release
    class SRD,SRO ops
    class BF utility