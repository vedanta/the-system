{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Grep",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(date:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/checkpoint.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '🏢 The System - Software Company Agent System' && echo '' && ls $CLAUDE_PROJECT_DIR/.claude/pipeline/projects/*.md 2>/dev/null | grep -v TEMPLATE || echo 'No active projects. Run new-project <name> to start.'"
          }
        ]
      }
    ]
  }
}
