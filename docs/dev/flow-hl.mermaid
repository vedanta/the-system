flowchart TD
  %% High-level: ASDO System Architecture (The System)
  subgraph Inputs["Inputs"]
    IDEA["💡 Idea Input<br/>Text • File • Interactive"]
  end

  subgraph Control["Orchestration & State"]
    FA["🎩 Founder-Advisor (Router)<br/>State Manager • Command Hub"]
    PROJECT["📋 Project File / State Store<br/>Progress • Decisions • Artifacts"]
    CMD["📋 Core Commands<br/>/ts-new-project • /ts-status • /ts-approve • /ts-review • /ts-help"]
  end

  subgraph Pipeline["Department Pipeline"]
    ARCH["📐 Architecture Dept"]
    G1{"🚦 HITL Gate 1<br/>Architecture Lock"}

    PROD["📦 Product Dept"]
    G2{"🚦 HITL Gate 2<br/>Green Light"}

    DEV["💻 Development Dept"]
    G3{"🚦 HITL Gate 3<br/>Dev Complete"}

    REL["🚀 Release & Deployment"]
    G4{"🚦 HITL Gate 4<br/>Production Ready"}

    OPS["🌐 Go Live & Operations"]
    G5{"🚦 HITL Gate 5<br/>Launch"}
  end

  subgraph Utilities["Utilities"]
    BF["🐛 Bug Fixer<br/>On-demand diagnostics & fixes"]
    TURBO["⚡ Turbo Mode<br/>Autonomous (Stages 1–4)"]
  end

  subgraph Output["Output"]
    OUT["🎉 Production System<br/>App • Tests • Docs • CI/CD • Monitoring"]
  end

  %% Primary flow
  IDEA --> FA
  CMD -.-> FA
  FA <--> PROJECT

  FA --> ARCH --> G1 -->|Approved| PROD --> G2 -->|Approved| DEV --> G3 -->|Approved| REL --> G4 -->|Approved| OPS --> G5 -->|Approved| OUT

  %% Turbo path
  FA -.->|/ts-turbo| TURBO
  TURBO -.-> OUT

  %% Utility path
  BF -.->|/ts-fix| DEV
  BF -.->|On demand| REL

  %% Styles
  classDef input fill:#FFF7E6,stroke:#D2691E,stroke-width:2px
  classDef control fill:#FFE4B5,stroke:#D2691E,stroke-width:3px
  classDef stage fill:#E6F3FF,stroke:#4169E1,stroke-width:2px
  classDef gate fill:#FFE4E1,stroke:#DC143C,stroke-width:2px
  classDef util fill:#F5F5DC,stroke:#8B4513,stroke-width:2px
  classDef output fill:#E0FFE0,stroke:#228B22,stroke-width:3px
  classDef turbo fill:#FFB6C1,stroke:#FF1493,stroke-width:2px

  class IDEA input
  class FA,PROJECT,CMD control
  class ARCH,PROD,DEV,REL,OPS stage
  class G1,G2,G3,G4,G5 gate
  class BF util
  class TURBO turbo
  class OUT output
