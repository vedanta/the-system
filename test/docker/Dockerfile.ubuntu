FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    nodejs \
    npm \
    bash \
    zsh \
    shellcheck \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create test user
RUN useradd -m -s /bin/bash testuser
USER testuser
WORKDIR /home/testuser

# Copy test files
COPY --chown=testuser:testuser install.sh /home/testuser/
COPY --chown=testuser:testuser test/ /home/testuser/test/

# Set up test environment
RUN chmod +x install.sh test/install-test.sh

# Default command
CMD ["./test/install-test.sh"]