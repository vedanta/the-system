# ============================================================================
# THE SYSTEM - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================================

# ----------------------------------------------------------------------------
# CLOUD PROVIDER CREDENTIALS
# ----------------------------------------------------------------------------

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# GCP (path to service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ----------------------------------------------------------------------------

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (if using social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# THIRD-PARTY SERVICES - FINANCIAL
# ----------------------------------------------------------------------------

# Plaid (for banking integrations)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox  # sandbox, development, production

# Stripe (for payments)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# THIRD-PARTY SERVICES - COMMUNICATION
# ----------------------------------------------------------------------------

# SendGrid (email)
SENDGRID_API_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Slack (notifications)
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# THIRD-PARTY SERVICES - AI/ML
# ----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# MONITORING & LOGGING
# ----------------------------------------------------------------------------

# Sentry (error tracking)
SENTRY_DSN=

# Datadog
DATADOG_API_KEY=

# LogDNA / Mezmo
LOGDNA_INGESTION_KEY=

# ----------------------------------------------------------------------------
# DEPLOYMENT
# ----------------------------------------------------------------------------

# Docker Registry
DOCKER_REGISTRY=
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Kubernetes
KUBECONFIG_PATH=

# Vercel
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Netlify
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------

# Environment
NODE_ENV=development
PYTHON_ENV=development

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api/v1

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------

ENABLE_DEBUG=true
ENABLE_SWAGGER=true
ENABLE_RATE_LIMITING=false
# ============================================================================
# THE SYSTEM - Stage 5 Environment Variables (add to existing .env.example)
# ============================================================================

